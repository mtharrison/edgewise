{
  "name": "edgewise",
  "productName": "Edgewise",
  "version": "0.3.0",
  "description": "A modern logic analyzer with a Rust core",
  "author": "Matt Harrison <hi@matt-harrison.com>",
  "main": "out/main/index.js",
  "license": "MIT",
  "private": true,
  "scripts": {
    "native": "node scripts/build-native.mjs",
    "dev": "npm run native && electron-vite dev",
    "build": "npm run native && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --release -p logic-core && vitest run",
    "package": "npm run build && node scripts/fetch-firmware.mjs && electron-builder --publish never && node scripts/check-bundle.mjs",
    "pr": "bash scripts/pr-run.sh"
  },
  "dependencies": {
    "lucide-react": "^1.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.15.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
